# Copy to .env.local for local development.
# Set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit .env.local. Only this example file belongs in Git.

# --- Public (safe to expose in the browser) ---
# Supabase project URL. Used by the server today; the NEXT_PUBLIC_ prefix
# is the Supabase convention if a public read is added later.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase anon key. Not used by the contact form. Do not grant it write
# access to project_inquiries or the project-files bucket.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never prefix these with NEXT_PUBLIC_) ---
# Bypasses row level security. The contact API uses it to insert enquiries
# and upload private files. Never ship this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key. If this or CONTACT_TO_EMAIL is empty, enquiries are still
# saved and the form still succeeds. Mail is skipped and logged.
RESEND_API_KEY=

# Inbox that receives new enquiries.
CONTACT_TO_EMAIL=hello@yourdomain.com

# Optional sender. Must be a verified Resend domain before it can mail
# visitors. If unset, Resend's test sender is used (it can only deliver
# to the address on the Resend account).
CONTACT_FROM_EMAIL=Opportunity Lens <hello@yourdomain.com>
